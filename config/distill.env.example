# LoopEngineer distill 配置模板：复制为 config/distill.env 并填写实际值。
# distill.env 已被 .gitignore 排除，严禁提交到 git。
CODEX_SESSIONS_DIR=~/.codex/sessions
AWESOME_SKILLS_DIR=~/Codes/awesome-skills
AWESOME_SKILLS_REPO=git@github.com:ml-inory/awesome-skills.git
LOOP_REPO_DIR=~/Codes/LoopEngineer

# 通知通道（可选）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
PUSHPLUS_TOKEN=

# 蒸馏参数
CLUSTER_MIN_SESSIONS=2
CLUSTER_THRESHOLD=0.35
COVERAGE_THRESHOLD=0.8
HIGH_VALUE_SINGLE_SCORE=55
